{
  "name": "krug-coffee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "milo — современная кофейня. Адаптивный сайт на русском языке.",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "check": "node --check dist/app.js && node --check worker/index.js && node scripts/check.mjs",
    "build": "pnpm run check",
    "seed:demo:local": "node scripts/seed-demo.mjs",
    "seed:demo:remote": "node scripts/seed-demo.mjs --remote",
    "smoke": "node scripts/smoke.mjs",
    "smoke:admin": "node scripts/admin-smoke.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
